@model LowStockViewModel
@{
    ViewData["Title"] = "低庫存警示";
}

<h1 class="h3 mb-3">低庫存警示</h1>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label asp-for="Threshold" class="form-label"></label>
        <input asp-for="Threshold" type="number" min="1" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">查詢</button>
    </div>
    <div class="col-12">
        <span asp-validation-for="Threshold" class="text-danger"></span>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>SKU</th>
            <th>名稱</th>
            <th class="text-end">現有庫存</th>
            <th class="text-end">近 30 天售出</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="4" class="text-center text-muted py-4">沒有低於門檻的商品</td>
            </tr>
        }
        @foreach (var item in Model.Items)
        {
            <tr class="@(item.StockQuantity < 5 ? "table-danger" : "")">
                <td>@item.Sku</td>
                <td>@item.Name</td>
                <td class="text-end">@item.StockQuantity</td>
                <td class="text-end">@item.SoldLast30Days</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
